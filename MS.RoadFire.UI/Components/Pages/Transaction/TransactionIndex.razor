@page "/transaction"

@using MS.RoadFire.Business.Models
@using System.Globalization

<MudPaper Class="pa-4 mx-auto" Style="max-width: 100%; background-color: transparent; box-shadow: none; color: black;">
    <style>
        .mud-input-label,
        .mud-input-slot,
        .mud-select-input,
        .mud-input,
        .mud-typography {
            color: black !important;
        }
    </style>
    <MudText Typo="Typo.h5" GutterBottom="true">Salida y/o Entrada Productos</MudText>

    <EditForm Model="@transaction">
        <DataAnnotationsValidator />

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Fecha" Value="@DateTime.Today.ToString("dd/MM/yyyy")" ReadOnly="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField Label="Descripción" @bind-Value="transaction.Description" Required />
            </MudItem>

            <MudItem xs="12" sm="5">
                <MudAutocomplete T="string"
                                 Label="Tipo de movimiento"
                                 Dense="true"
                                 Clearable="true"
                                 Required="true"
                                 @bind-Value="selectType"
                                 SearchFunc="@SearchTypes"
                                 ToStringFunc="@(p => p ?? string.Empty)"
                                 ResetValueOnEmptyText="true"
                                 Style="background-color: transparent; color: black;" />
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />
        <MudGrid>
            <MudItem xs="12" sm="5">
                <MudAutocomplete T="ProductDto"
                                 Label="Producto"
                                 Dense="true"
                                 Clearable="true"
                                 Required="true"
                                 @bind-Value="SelectProduct"
                                 ToStringFunc="@(p => p is null ? string.Empty : p.Description)"
                                 SearchFunc="SearchProductsAsync"
                                 ResetValueOnEmptyText="true"
                                 Style="background-color: transparent; color: black;" />
            </MudItem>

            <MudItem xs="12" sm="3">
                <MudTextField T="int" Label="Cantidad" @bind-Value="quantity" Min="1" Dense="true" />
            </MudItem>

            <MudItem xs="12" sm="4" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Info" Disabled="@(!CanAddProduct)" OnClick="AddProduct">
                    <MudIcon Icon="@Icons.Material.Filled.Add" /> Agregar
                </MudButton>
            </MudItem>
        </MudGrid>

        <MudSpacer />
        <MudText Typo="Typo.h4" Align="Align.Center" Class="my-4" Style="font-weight: bold;">Lista de productos</MudText>

        @if (transaction.TransactionDetailDtos.Count > 0)
        {
            <MudTable Items="@transaction.TransactionDetailDtos" Dense="true" Hover="true" Class="mt-3">
                <HeaderContent>
                    <MudTh>Producto</MudTh>
                    <MudTh>Cantidad</MudTh>
                    <MudTh>Precio Unitario</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="item">
                    <MudTd>@item.ProductDescription</MudTd>
                    <MudTd>@item.Quantity</MudTd>
                    <MudTd>@item.UnitValue.ToString("C0", CultureInfo.CurrentCulture)</MudTd>
                    <MudTd>@item.Total.ToString("C0", CultureInfo.CurrentCulture)</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="@(() => RemoveProduct(item))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.h6" Align="Align.Right" Class="mt-3">
                Total general: <b>@TotalAmount.ToString("C0", CultureInfo.CurrentCulture)</b>
            </MudText>
        }

        <MudDivider Class="my-4" />

        <MudButton Variant="Variant.Filled" Class="mr-4" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Info" OnClick="ReturnAction">Regresar</MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Success" Type="Submit" OnClick="@(() => SaveTransaction())">
            <MudIcon Icon="@Icons.Material.Filled.Save" /> Guardar Venta
        </MudButton>

    </EditForm>
</MudPaper>

