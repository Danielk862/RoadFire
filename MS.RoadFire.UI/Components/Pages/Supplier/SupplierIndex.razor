@page "/suppliers"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Suppliers"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between">
                <MudText Typo="Typo.h6" Class="me-4 title-table">Proveedores</MudText>
                <MudButton Variant="Variant.Filled" Class="mr-4" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Info" OnClick="ReturnAction">Atrás</MudButton>
                <MudButton Variant="Variant.Filled"
                           EndIcon="@Icons.Material.Filled.Add"
                           Color="Color.Success" OnClick="@(() => ShowModalAsync())">
                    Nuevo
                </MudButton>
            </div>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width:250px">Nombre</MudTh>
            <MudTh style="width: 250px;">Dirección</MudTh>
            <MudTh style="width: 250px;">Telefono</MudTh>
            <MudTh style="width: 250px;">Nit</MudTh>
            <MudTh style="width: 250px;">Persona contacto</MudTh>
            <MudTh style="width: 250px;">WebSite</MudTh>
            <MudTh style="width: 250px;">Descripción</MudTh>
            <MudTh style="width: 270px;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Address</MudTd>
            <MudTd>@context.Phone</MudTd>
            <MudTd>@context.Nit</MudTd>
            <MudTd>@context.ContactPerson</MudTd>
            <MudTd>@context.Website</MudTd>
            <MudTd>@context.Description</MudTd>
            <MudTd>
                <MudTooltip Text="Editar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               OnClick="@(() => ShowModalAsync(context.Id, true))">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="color=#000000 !important;">"No hay registros"</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat"
                           Class="custome-page" />
        </PagerContent>
    </MudTable>
}