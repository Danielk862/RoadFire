<EditForm Model="@CurrentRole" OnValidSubmit="() => OnValidSubmit.InvokeAsync()">
    <DataAnnotationsValidator />

    <MudTextField Label="Nombre del Rol"
                  @bind-Value="CurrentRole.Name"
                  For="@(() => CurrentRole.Name)"
                  Required="true"
                  Class="mb-4" />

    <MudTextField Label="Descripción"
                  @bind-Value="CurrentRole.Description"
                  For="@(() => CurrentRole.Description)"
                  Required="true"
                  Class="mb-4" />

    <MudCheckBox T="bool"
                 @bind-Value="CurrentRole.IsActive"
                 Label="Activo"
                 Class="mb-4" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Info"
               OnClick="() => ReturnAction.InvokeAsync()"
               Style="min-width: 120px; height: 45px;">
        Cancelar
    </MudButton>

    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               ButtonType="ButtonType.Submit"
               Style="min-width: 120px; height: 45px;">
        Guardar
    </MudButton>
</EditForm>
