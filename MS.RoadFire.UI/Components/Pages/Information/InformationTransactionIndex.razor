@page "/informationTransaction"

@using System.Globalization
@using MS.RoadFire.UI.Components.Pages.Information

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Transaction"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between">
                <MudText Typo="Typo.h6" Class="me-4 title-table">Informe de entradas y salidas</MudText>
                <MudButton Variant="Variant.Filled" Class="mr-4" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Info" OnClick="ReturnAction" Style="min-width: 120px; height: 45px;">Atrás</MudButton>
            </div>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh style="width: 350px;">Descripción</MudTh>
            <MudTh style="width: 250px;">Fecha</MudTh>
            <MudTh style="width: 250px;">Tipo</MudTh>
            <MudTh style="width: 250px;">Usuario</MudTh>
            <MudTh style="width: 250px;">Detalle</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Description</MudTd>
            <MudTd>@context.Date.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@context.Type</MudTd>
            <MudTd>@context.Username</MudTd>
            <MudTd>
                <MudTooltip Text="Detalles">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               OnClick="@(() => ShowDetailsPopup(context))">
                        <MudIcon Icon="@Icons.Material.Filled.Visibility" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="color=#000000 !important;">"No hay registros"</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat"
                           Class="custome-page" />
        </PagerContent>
    </MudTable>
}