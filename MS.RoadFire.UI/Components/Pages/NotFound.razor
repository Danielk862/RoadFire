@page "/notFound"

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column justify-center align-center" Style="height: 100vh;">

    <MudPaper Elevation="4" Class="p-6 text-center" Style="border-radius: 20px;">

        <MudText Typo="Typo.h1" Class="mb-2" Color="Color.Error">
            404
        </MudText>

        <MudText Typo="Typo.h5" Class="mb-4">
            Página no encontrada
        </MudText>

        <MudText Typo="Typo.body1" Class="mb-6">
            Lo sentimos, la página que estás buscando no existe o fue movida.
        </MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">
            Volver al inicio
        </MudButton>

    </MudPaper>

</MudContainer>