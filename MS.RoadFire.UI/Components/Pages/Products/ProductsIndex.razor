@page "/productsIndex"

@using System.Globalization

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Products"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between">
                <MudText Typo="Typo.h6" Class="me-4 title-table">Productos</MudText>
                <MudButton Variant="Variant.Filled" Class="mr-4" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Tertiary" OnClick="ReturnAction" Style="min-width: 120px; height: 45px;">Atrás</MudButton>
                <MudButton Variant="Variant.Filled"
                           EndIcon="@Icons.Material.Filled.Add"
                           Color="Color.Info"
                           OnClick="@(() => ShowModalAsync())"
                           Style="min-width: 120px; height: 45px;">
                    Nuevo
                </MudButton>
            </div>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>

        <HeaderContent>
            <MudTh Style="width:250px">Sku</MudTh>
            <MudTh Style="width:250px">Descripción</MudTh>
            <MudTh Style="width:150px">Precio</MudTh>
            <MudTh Style="width:200px">Categoría</MudTh>
            <MudTh Style="width:200px">Proveedor</MudTh>
            <MudTh Style="width:200px">Estado</MudTh>
            <MudTh Style="width:270px">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.Sku</MudTd>
            <MudTd>@context.Description</MudTd>
            <MudTd>@context.Price.ToString("C0", CultureInfo.CurrentCulture)</MudTd>
            <MudTd>@context.CategoryName</MudTd>
            <MudTd>@context.SupplierName</MudTd>
            <MudTd>
                <MudIcon Icon="@(context.IsActive? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                         Color="@(context.IsActive ? Color.Success : Color.Error)"
                         Style="vertical-align: middle;" />
            </MudTd>
            <MudTd>
                <MudTooltip Text="Editar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               OnClick="@(() => ShowModalAsync(context.Id, true))">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                    </MudButton>
                </MudTooltip>
                <MudTooltip Text="Borrar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="@(() => DeleteAsync(@context))">
                        <MudIcon Icon="@Icons.Material.Filled.Delete" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Style="color: #000000 !important;">No hay roles registrados</MudText>
        </NoRecordsContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat"
                           Class="custome-page" />
        </PagerContent>
    </MudTable>
}
