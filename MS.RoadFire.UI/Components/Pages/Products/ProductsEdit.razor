@page "/products/edit/{Id:int}"

@if (Product is null)
{
    <Loading />
}
else
{
    <MudDialog>
        <DialogContent>
            <ProductsForm Product="Product"
                      Categories="Categories"
                      Suppliers="Suppliers"
                      IsEdit="true"
                      OnValidSubmit="EditAsync"
                      ReturnAction="Return" />
        </DialogContent>
    </MudDialog>
}