@page "/stocks"

@using System.Globalization

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Stocks"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between">
                <MudText Typo="Typo.h6" Class="me-4 title-table">Inventario</MudText>
                <MudButton Variant="Variant.Filled" Class="mr-4" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Info" OnClick="ReturnAction">Atrás</MudButton>
            </div>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width:250px">Id</MudTh>
            <MudTh style="width: 250px;">Descripción</MudTh>
            <MudTh style="width: 250px;">Cantidad</MudTh>
            <MudTh style="width: 250px;">Valor Unitario</MudTh>
            <MudTh style="width: 250px;">Valor Total</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.ProductId</MudTd>
            <MudTd>@context.ProductDescription</MudTd>
            <MudTd>@context.Quantity</MudTd>
            <MudTd>@context.ValueUnit.ToString("C0", CultureInfo.CurrentCulture)</MudTd>
            <MudTd>@context.Total.ToString("C0", CultureInfo.CurrentCulture)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="color=#000000 !important;">"No hay registros"</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat"
                           Class="custome-page" />
        </PagerContent>
    </MudTable>
}
