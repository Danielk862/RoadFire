@page "/customers"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Customers"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between">
                <MudText Typo="Typo.h6" Class="me-4 title-table">Clientes</MudText>
                <MudButton Variant="Variant.Filled" Class="mr-4" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Info" OnClick="ReturnAction" Style="min-width: 120px; height: 45px;">Atrás</MudButton>
                <MudButton Variant="Variant.Filled"
                           EndIcon="@Icons.Material.Filled.Add"
                           Color="Color.Success" OnClick="@(() => ShowModalAsync())"
                           Style="min-width: 120px; height: 45px;">
                    Nuevo
                </MudButton>
            </div>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width:250px">Tipo Identificación</MudTh>
            <MudTh style="width: 250px;">Identificación</MudTh>
            <MudTh style="width: 250px;">Primer Nombre</MudTh>
            <MudTh style="width: 250px;">Segundo Nombre</MudTh>
            <MudTh style="width: 250px;">Primer Apellido</MudTh>
            <MudTh style="width: 250px;">Segundo Apellido</MudTh>
            <MudTh style="width: 250px;">Dirección</MudTh>
            <MudTh style="width: 250px;">Teléfono</MudTh>
            <MudTh style="width: 250px;">Email</MudTh>
            <MudTh style="width: 250px;">Estado</MudTh>
            <MudTh style="width: 270px;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.TypeIdentification</MudTd>
            <MudTd>@context.Identification</MudTd>
            <MudTd>@context.FirstName</MudTd>
            <MudTd>@context.SecondName</MudTd>
            <MudTd>@context.Surname</MudTd>
            <MudTd>@context.SecondSurname</MudTd>
            <MudTd>@context.Address</MudTd>
            <MudTd>@context.Phone</MudTd>
            <MudTd>@context.Email</MudTd>
            <MudTd>
                <MudIcon Icon="@(context.IsActive? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                         Color="@(context.IsActive ? Color.Success : Color.Error)"
                         Style="vertical-align: middle;" />
            </MudTd>
            <MudTd>
                <MudTooltip Text="Editar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               OnClick="@(() => ShowModalAsync(context.Id, true))">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" />
                    </MudButton>
                </MudTooltip>
                <MudTooltip Text="Borrar">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="@(() => DeleteAsync(@context))">
                        <MudIcon Icon="@Icons.Material.Filled.Delete" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="color=#000000 !important;">"No hay registros"</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat"
                           Class="custome-page" />
        </PagerContent>
    </MudTable>
}