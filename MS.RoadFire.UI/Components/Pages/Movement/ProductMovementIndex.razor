@page "/movements"

@using MS.RoadFire.Business.Models
@using System.Globalization

@if (loading)
{
    <Loading />
}
else
{
    <MudGrid Class="mb-4" AlignItems="Center">
        <style>
            .mud-input-label,
            .mud-input-slot,
            .mud-select-input,
            .mud-input,
            .mud-typography {
                color: black !important;
            }

            .table-black-pager .mud-table-pagination,
            .table-black-pager .mud-table-pagination * {
                color: black !important;
            }
        </style>
        <MudItem xs="12" sm="5">
            <MudAutocomplete T="ProductDto"
                             Label="Seleccionar un producto.."
                             Dense="true"
                             Clearable="true"
                             Required="true"
                             @bind-Value="SelectProduct"
                             ToStringFunc="@(p => p is null ? string.Empty : p.Description)"
                             SearchFunc="SearchProductsAsync"
                             ResetValueOnEmptyText="true"
                             OnClearButtonClick="OnProductChange"
                             Style="background-color: transparent; color: white;" />
        </MudItem>

        <MudItem xs="12" sm="7">
            <div class="d-flex justify-content-end gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="LoadProductMovements">
                    Buscar
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Info"
                           OnClick="ReturnAction">
                    Regresar
                </MudButton>
            </div>
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-content-center mt-3">
            <MudText Typo="Typo.h6" Class="me-4">Movimientos</MudText>
        </MudItem>

    </MudGrid>

    <MudTable Items="@productMovements"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true"
              Class="table-black-pager">
        <ToolBarContent>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Descripción</MudTh>
            <MudTh>Tipo Movimiento</MudTh>
            <MudTh>Fecha</MudTh>
            <MudTh>Cantidad</MudTh>
            <MudTh>Total unitario</MudTh>
            <MudTh>Total</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Description</MudTd>
            <MudTd>@context.Type</MudTd>
            <MudTd>@context.Date.ToString("dd/MM/yyyy")</MudTd>
            <MudTd>@context.Quantity</MudTd>
            <MudTd>@context.UnitCost.ToString("C0", CultureInfo.CurrentCulture)</MudTd>
            <MudTd>@context.TotalCost.ToString("C0", CultureInfo.CurrentCulture)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No hay registros</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Filas por página"
                           AllItemsText="Todos"
                           OfText="de"
                           InfoFormat="Mostrando {first_item}-{last_item} de {all_items}"
                           ItemsPerPageOptions="new int[] { 5, 10, 20, 50 }" />
        </PagerContent>
    </MudTable>
}
